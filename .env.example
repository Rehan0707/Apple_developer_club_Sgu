# Local-only preview. This is ignored when NODE_ENV=production.
LOCAL_PREVIEW=true
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/club.sqlite
# Run npm run setup:local to generate a local admin configuration.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Server-only Apple configuration for a later HTTPS deployment.
PUBLIC_ORIGIN=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Google OAuth web client. Register this exact redirect URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback

# Firebase Authentication for local Google sign-in. Web config values are public.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
