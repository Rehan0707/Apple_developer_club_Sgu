# Server-side values only. Never put secrets in VITE_ variables.
PORT=3001
PUBLIC_ORIGIN=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Register https://your-domain/api/auth/apple/callback as the Apple return URL.

# Admin Portal credentials; ADMIN_PASSWORD_HASH must be a scrypt hash, never a raw password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional website-server Google Sheets sync. Keep the service-account key out of Git.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Firebase Cloud Firestore (auto-configured for apple-developer-club-sgu)
FIREBASE_PROJECT_ID=apple-developer-club-sgu
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=apple-developer-club-sgu.firebaseapp.com
FIREBASE_STORAGE_BUCKET=apple-developer-club-sgu.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=

